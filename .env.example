# YouTubeチャンネル設定
YOUTUBE_CHANNEL_ID=UCgDa6dxD3jPElw6eCvL1T2g

# Google Drive API 設定（サービスアカウントJSON文字列と対象フォルダID）
GDRIVE_FOLDER_ID=your_google_drive_folder_id_here
GDRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# 同名ファイルが存在する場合の挙動（skip または overwrite）
GDRIVE_DUPLICATE_POLICY=skip

# ドライラン（true の場合はDriveアップロードおよびprocessed_ids.json更新をスキップ）
DRY_RUN=false
